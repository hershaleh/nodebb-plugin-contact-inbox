{
  "id": "nodebb-plugin-contact-inbox",
  "name": "Contact Inbox",
  "description": "Private contact inbox for NodeBB with staff permissions and configurable email options.",
  "url": "https://github.com/hershaleh/nodebb-plugin-contact-inbox",
  "library": "./library.js",
  "hooks": [
    { "hook": "static:app.load", "method": "init" },
    { "hook": "static:api.routes", "method": "addRoutes" },
    { "hook": "filter:admin.header.build", "method": "addAdminNavigation" }
  ],
  "scripts": [
    "public/lib/inbox.js"
  ],
  "scss": [
    "public/lib/inbox.scss"
  ],
  "staticDirs": {
    "public": "./public"
  },
  "templates": "./templates"
}