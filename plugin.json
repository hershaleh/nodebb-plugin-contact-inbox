{
  "id": "nodebb-plugin-contact-inbox",
  "name": "Contact Inbox",
  "description": "Secure contact form inbox for NodeBB administrators.",
  "url": "https://github.com/hershaleh/nodebb-plugin-contact-inbox",
  "library": "./library.js",
  "hooks": [
    { "hook": "static:app.load", "method": "init" },
    { "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
    { "hook": "filter:router.page", "method": "addRoutes" },
    { "hook": "filter:plugin.getNavigation", "method": "addNavigation" }
  ],
  "scripts": [
    "public/lib/inbox.js",
    "public/lib/admin.js"
  ],
  "staticDirs": {
    "public": "./public"
  },
  "languages": "languages"
}